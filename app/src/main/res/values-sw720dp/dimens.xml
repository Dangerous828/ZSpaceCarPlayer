    <!-- 纵向骨架 -->
    <dimen name="topbar_h">88dp</dimen>
    <dimen name="head_h">44dp</dimen>
    <dimen name="bar_h">140dp</dimen>
    <dimen name="bar_margin_b">14dp</dimen>
