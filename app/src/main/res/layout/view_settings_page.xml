<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 设置分块 1: 实时歌词调节 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时歌词微调"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="歌词时间轴同步"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/card_title_size" />

                <Button
                    android:id="@+id/btnSettingLrcSub"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:text="-0.5s"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />

                <Button
                    android:id="@+id/btnSettingLrcAdd"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_soft_pill"
                    android:text="+0.5s"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="歌词字体大小"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/card_title_size" />

                <Button
                    android:id="@+id/btnSettingLrcFont"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_badge_hi"
                    android:text="字号:中"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 设置分块 2: 音效与配置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="音频与服务器"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSettingOpenEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎛️"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EQ 音效均衡器"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="全景声场 · 空间混响 · 低音增强调节"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/card_title_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettingOpenServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务器与账号配置"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="极空间 / Jellyfin 服务器地址及凭据"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/card_title_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettingEngineToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播放引擎 (v3 实验特性)"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="v3=自研软解+C++音效, 系统=车机原生兼容"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingEngineValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="系统"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 音质档位: 车主手选, 循环两档 (无损 / 流畅)。2026-10-08 T1 重审 L2 的结论是
                 "把选择权交回人"——自动降档已被否决, 所以这里没有第三条"自动"路径,
                 副标题里的码率数字必须是服务端实测值(256kbps), 不许写请求参数上的 128。 -->
            <LinearLayout
                android:id="@+id/btnSettingTierToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="质"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="音质"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingTierDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="原始文件直传，本库实测需 100~151KB/s"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingTierValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="无损"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 取流改造回退闸 + 播放缓存 (2026-10-08)。这两行是"出问题时不用重出包就能退回
                 旧行为"的唯一出路，也是车主知道自己设备里存了什么、能一键抹掉的入口。
                 副标题写成人话：先说这是干什么的，再说关掉会怎样。 -->
            <LinearLayout
                android:id="@+id/btnSettingTuningToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="取流优化"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="少建连接、少等首字节；关掉退回旧版取流方式"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingTuningValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="开"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="存"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播放缓存"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingCacheDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="已用 0 MB / 上限 1 GB"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingCacheClear"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_soft_pill"
                    android:singleLine="true"
                    android:text="清空"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />

                <Button
                    android:id="@+id/btnSettingCacheValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="开"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 睡眠定时 (2026-10-08 T1 基准补齐)：循环 关/15/30/45/60/90 分钟。
                 到点是「立即暂停」而不是「播完这首」，理由写在 SleepTimer 的类注释里。 -->
            <LinearLayout
                android:id="@+id/btnSettingSleepToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="眠"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="睡眠定时"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingSleepDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="到点立即暂停播放"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingSleepValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="关"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 夜间模式: 三档循环 (自动 / 白天 / 夜间)。API 18 车机字体缺日月图形字符,
                 图标位用汉字, 不用 emoji。 -->
            <LinearLayout
                android:id="@+id/btnSettingNightToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/dialog_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="夜间模式"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="自动=18 点至次日 6 点转深色; 深色为琥珀底, 夜里不刺眼"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingNightValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="自动"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 设置分块 3: 远程升级 (2026-09-12) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="关于与升级"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowSettingCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <!-- 用文字徽标而非图标字符: 车机 API18 的系统字体缺字形会显示成方框 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hi"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="OTA"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/card_sub_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查更新"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="当前版本 3.0.0"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="检查更新"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSettingAutoUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hi"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="自动"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/card_sub_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="启动时自动检查更新"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="冷启动约 20 秒后静默检查, 有新版本才提示"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingAutoUpdateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="开"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSettingUploadLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hi"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="LOG"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/card_sub_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="立即上报诊断日志"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="卡顿/缓冲/切歌错乱等现场一键打包发给开发者"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingUploadLog"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="上报日志"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
