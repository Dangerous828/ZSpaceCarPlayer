<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 设置分块 1: 实时歌词调节 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时歌词微调"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="歌词时间轴同步"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/card_title_size" />

                <Button
                    android:id="@+id/btnSettingLrcSub"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:text="-0.5s"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />

                <Button
                    android:id="@+id/btnSettingLrcAdd"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_soft_pill"
                    android:text="+0.5s"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="歌词字体大小"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/card_title_size" />

                <Button
                    android:id="@+id/btnSettingLrcFont"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_badge_hi"
                    android:text="字号:中"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 设置分块 2: 音效与配置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="音频与服务器"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSettingOpenEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎛️"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EQ 音效均衡器"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="全景声场 · 空间混响 · 低音增强调节"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/card_title_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettingOpenServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务器与账号配置"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="极空间 / Jellyfin 服务器地址及凭据"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/card_title_size" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
