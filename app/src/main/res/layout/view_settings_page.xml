<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 设置分块 1: 实时歌词调节 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实时歌词微调"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="歌词时间轴同步"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/card_title_size" />

                <Button
                    android:id="@+id/btnSettingLrcSub"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:text="-0.5s"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />

                <Button
                    android:id="@+id/btnSettingLrcAdd"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_soft_pill"
                    android:text="+0.5s"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="歌词字体大小"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/card_title_size" />

                <Button
                    android:id="@+id/btnSettingLrcFont"
                    android:layout_width="@dimen/font_w"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_badge_hi"
                    android:text="字号:中"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 设置分块 2: 音效与配置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="音频与服务器"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSettingOpenEq"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎛️"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EQ 音效均衡器"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="全景声场 · 空间混响 · 低音增强调节"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/card_title_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettingOpenServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务器与账号配置"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="极空间 / Jellyfin 服务器地址及凭据"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/card_title_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnSettingEngineToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="@dimen/dialog_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="播放引擎 (v3 实验特性)"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="v3=自研软解+C++音效, 系统=车机原生兼容"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingEngineValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="系统"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 夜间模式: 三档循环 (自动 / 白天 / 夜间)。API 18 车机字体缺日月图形字符,
                 图标位用汉字, 不用 emoji。 -->
            <LinearLayout
                android:id="@+id/btnSettingNightToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="夜"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/dialog_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="夜间模式"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="自动=18 点至次日 6 点转深色; 深色为琥珀底, 夜里不刺眼"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingNightValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="自动"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <!-- 设置分块 3: 远程升级 (2026-09-12) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="关于与升级"
                android:textColor="@color/accent"
                android:textSize="@dimen/dialog_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/rowSettingCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <!-- 用文字徽标而非图标字符: 车机 API18 的系统字体缺字形会显示成方框 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hi"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="OTA"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/card_sub_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查更新"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="当前版本 3.0.0"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="检查更新"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSettingAutoUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hi"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="自动"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/card_sub_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="启动时自动检查更新"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="冷启动约 20 秒后静默检查, 有新版本才提示"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingAutoUpdateValue"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="开"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSettingUploadLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_grid"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_hi"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="LOG"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/card_sub_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="立即上报诊断日志"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="卡顿/缓冲/切歌错乱等现场一键打包发给开发者"
                        android:textColor="@color/ink_dim"
                        android:textSize="@dimen/card_sub_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingUploadLog"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/mini_h"
                    android:background="@drawable/bg_soft_pill"
                    android:minWidth="@dimen/font_w"
                    android:singleLine="true"
                    android:text="上报日志"
                    android:textAllCaps="false"
                    android:textColor="@color/ink_dim"
                    android:textSize="@dimen/mini_text" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
