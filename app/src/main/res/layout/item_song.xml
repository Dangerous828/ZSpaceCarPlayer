<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_h"
    android:background="@drawable/bg_row_song"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <!-- 选中态左侧青绿指示条 -->
    <View
        android:id="@+id/accentBar"
        android:layout_width="3dp"
        android:layout_height="@dimen/accent_bar"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_accent_bar"
        android:visibility="gone" />

    <!-- 首字色块 (按歌曲 Id 哈希取 6 色渐变之一) -->
    <TextView
        android:id="@+id/tvThumb"
        android:layout_width="@dimen/thumb"
        android:layout_height="@dimen/thumb"
        android:background="@drawable/bg_thumb_1"
        android:gravity="center"
        android:text="歌"
        android:textColor="#F2FFFFFF"
        android:textSize="@dimen/thumb_text"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ink"
            android:textSize="@dimen/song_title"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvArtistAlbum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_mute"
                android:textSize="@dimen/artist" />

            <TextView
                android:id="@+id/tvGenreTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_chip"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="流行"
                android:textColor="@color/accent"
                android:textSize="@dimen/tag_text"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvFavIcon"
        android:layout_width="@dimen/fav_box"
        android:layout_height="@dimen/fav_box"
        android:gravity="center"
        android:text="♡"
        android:textColor="@color/ink_mute"
        android:textSize="@dimen/fav_size" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/ink_mute"
        android:textSize="@dimen/dur_text" />
</LinearLayout>
