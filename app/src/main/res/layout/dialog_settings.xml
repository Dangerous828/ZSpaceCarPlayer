<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A22"
    android:orientation="vertical"
    android:padding="24dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jellyfin / 极空间 服务器配置"
        android:textColor="#00E5FF"
        android:textSize="@dimen/dialog_title"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etServerUrl"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_input_h"
        android:layout_marginTop="16dp"
        android:background="#252632"
        android:hint="服务器 URL (例: http://your.domain/music)"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#606070"
        android:textSize="@dimen/dialog_text" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_input_h"
        android:layout_marginTop="12dp"
        android:background="#252632"
        android:hint="用户名"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#606070"
        android:textSize="@dimen/dialog_text" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_input_h"
        android:layout_marginTop="12dp"
        android:background="#252632"
        android:hint="密码"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#606070"
        android:textSize="@dimen/dialog_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="@dimen/dialog_btn_w_cancel"
            android:layout_height="@dimen/dialog_btn_h"
            android:background="@drawable/bg_button"
            android:text="取消"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/dialog_text" />

        <Button
            android:id="@+id/btnSaveAuth"
            android:layout_width="@dimen/dialog_btn_w_save"
            android:layout_height="@dimen/dialog_btn_h"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_btn_accent"
            android:text="登录并保存"
            android:textColor="#000000"
            android:textSize="@dimen/dialog_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
