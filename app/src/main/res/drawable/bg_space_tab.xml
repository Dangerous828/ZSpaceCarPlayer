<?xml version="1.0" encoding="utf-8"?>
<!-- EQ 空间混响档位: 选中态实心蓝 + 白字, 未选中态与 bg_button 一致 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_3" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/line_2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_2" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
